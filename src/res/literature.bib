	shortjournal = {Front. Neurosci.},
	publisher = {Frontiers},
	author = {Hao, Gao and Hijazi, Haytham and Durães, João and Medeiros, Júlio and Couceiro, Ricardo and Lam, Chan Tong and Teixeira, César and Castelhano, João and Castelo Branco, Miguel and Carvalho, Paulo and Madeira, Henrique},
