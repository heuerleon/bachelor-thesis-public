	keywords = {Software Quality, Software, Aggregates, Measurement, {IEC} standards, Software Maintainability, Benchmark testing, Histograms, {ISO}/{IEC} 9126, Quality Model, Random variables},
	file = {Full Text PDF:/Users/leon.heuer/Zotero/storage/ML89EUN7/Bakota et al. - 2011 - A probabilistic software quality model.pdf:application/pdf},
