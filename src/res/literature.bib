	keywords = {Design pattern, Software quality, Object-oriented metrics},
	file = {PDF:/Users/leon.heuer/Zotero/storage/4F5RKXWJ/Hsueh et al. - 2008 - A quantitative approach for evaluating the quality of design patterns.pdf:application/pdf;ScienceDirect Snapshot:/Users/leon.heuer/Zotero/storage/DMMJ439I/S0164121207003172.html:text/html},
